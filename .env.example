# 项目根目录：复制为 .env 后按需填写（.env 已在 .gitignore，勿提交）
# Docker Compose 会自动读取同目录下的 .env 用于变量替换。
#
# 若不在此文件中设置 POSTGRES_PASSWORD，compose 内仍可使用内置默认值（仅本地开发）；
# 正式/共用环境请务必在此设置强密码，并与 server/.env 的 DATABASE_URL 保持一致。

POSTGRES_USER=crm
POSTGRES_DB=crm

# 本地 Postgres 口令（留空则使用 compose 内与旧版一致的占位默认，便于开箱）
POSTGRES_PASSWORD=

# 映射到本机的端口
POSTGRES_PORT=5432

# api 容器使用的 JWT（留空则使用 compose 内默认占位）
JWT_SECRET=
