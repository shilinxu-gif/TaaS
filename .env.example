# 项目根目录：复制为 .env 后按需填写（.env 已在 .gitignore，勿提交）
# Docker Compose 会自动读取同目录下的 .env 用于变量替换。
#
# 若不在此文件中设置 POSTGRES_PASSWORD，compose 内仍可使用内置默认值（仅本地开发）；
# 正式/共用环境请务必在此设置强密码。

POSTGRES_USER=crm
POSTGRES_DB=crm

# 本地 Postgres 口令（留空则使用 compose 内与旧版一致的占位默认，便于开箱）
POSTGRES_PASSWORD=

# 映射到本机的端口
POSTGRES_PORT=5432

# 安全密钥（必填）
JWT_SECRET=
PROVIDER_CONFIG_SECRET=
APP_KEY_PEPPER=

# 启动时可选初始化平台管理员；留空则不自动创建/更新管理员
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=

# 商业化联络信息
SALES_EMAIL=sales@taas.example
SUPPORT_EMAIL=support@taas.example

# 真实上游供应商（可选；未配置时网关会返回真实配置错误）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
