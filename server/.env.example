# 必填：与项目根目录 .env 中 Postgres 一致（本机连 Docker 时 host=localhost）
# 将下列占位符改为与你的 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT 一致
DATABASE_URL="postgresql://CHANGE_USER:CHANGE_PASSWORD@localhost:5432/CHANGE_DB?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# 演示账号（执行 npx prisma db seed 后）：登录名 wangqiang，密码 123456
