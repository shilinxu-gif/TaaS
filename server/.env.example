# 必填：与项目根目录 .env 中 Postgres 一致（本机连 Docker 时 host=localhost）
# 将下列占位符改为与你的 POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_PORT 一致
DATABASE_URL="postgresql://CHANGE_USER:CHANGE_PASSWORD@localhost:5432/CHANGE_DB?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001

# 用于加密 Provider API Key
PROVIDER_CONFIG_SECRET="change-me-to-another-long-random-string"

# 用于 AppKey 哈希
APP_KEY_PEPPER="change-me-to-a-third-long-random-string"

# 商业化联络
SALES_EMAIL="sales@taas.example"
SUPPORT_EMAIL="support@taas.example"

# 上游供应商（本地可留空，网关会回退到演示回复）
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# 演示账号（执行 npx prisma db seed 后）：登录名 wangqiang，密码 123456
